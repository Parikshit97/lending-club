{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "adf-lendingclub"
        },
        "lcingestadls_accountKey": {
            "type": "secureString",
            "metadata": "Secure string for 'accountKey' of 'lcingestadls'"
        },
        "AzureDatabricks1_accessToken": {
            "type": "secureString",
            "metadata": "Secure string for 'accessToken' of 'AzureDatabricks1'"
        },
        "AzureDatabricks2_accessToken": {
            "type": "secureString",
            "metadata": "Secure string for 'accessToken' of 'AzureDatabricks2'"
        },
        "AzureDatabricks3_accessToken": {
            "type": "secureString",
            "metadata": "Secure string for 'accessToken' of 'AzureDatabricks3'"
        },
        "lcingestadls_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://lcingestadls.dfs.core.windows.net/"
        },
        "AzureDatabricks2_properties_typeProperties_existingClusterId": {
            "type": "string",
            "defaultValue": "1125-233119-o9n3i84a"
        },
        "AzureDatabricks3_properties_typeProperties_existingClusterId": {
            "type": "string",
            "defaultValue": "1125-233119-o9n3i84a"
        },
        "containerUri": {
            "type": "string",
            "metadata": "URI to storage account containing linked ARM templates"
        },
        "containerSasToken": {
            "type": "string",
            "metadata": "Sas token to storage account containing linked ARM templates"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "adf-lendingclub_ArmTemplate_0",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    },
                    "lcingestadls_accountKey": {
                        "value": "[parameters('lcingestadls_accountKey')]"
                    },
                    "AzureDatabricks1_accessToken": {
                        "value": "[parameters('AzureDatabricks1_accessToken')]"
                    },
                    "AzureDatabricks2_accessToken": {
                        "value": "[parameters('AzureDatabricks2_accessToken')]"
                    },
                    "AzureDatabricks3_accessToken": {
                        "value": "[parameters('AzureDatabricks3_accessToken')]"
                    },
                    "lcingestadls_properties_typeProperties_url": {
                        "value": "[parameters('lcingestadls_properties_typeProperties_url')]"
                    },
                    "AzureDatabricks2_properties_typeProperties_existingClusterId": {
                        "value": "[parameters('AzureDatabricks2_properties_typeProperties_existingClusterId')]"
                    },
                    "AzureDatabricks3_properties_typeProperties_existingClusterId": {
                        "value": "[parameters('AzureDatabricks3_properties_typeProperties_existingClusterId')]"
                    }
                }
            },
            "dependsOn": []
        }
    ]
}