{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "adf-lendingclub"
        },
        "lcingestadls_accountKey": {
            "type": "secureString",
            "metadata": "Secure string for 'accountKey' of 'lcingestadls'"
        },
        "AzureDatabricks1_accessToken": {
            "type": "secureString",
            "metadata": "Secure string for 'accessToken' of 'AzureDatabricks1'"
        },
        "AzureDatabricks2_accessToken": {
            "type": "secureString",
            "metadata": "Secure string for 'accessToken' of 'AzureDatabricks2'"
        },
        "AzureDatabricks3_accessToken": {
            "type": "secureString",
            "metadata": "Secure string for 'accessToken' of 'AzureDatabricks3'"
        },
        "lcingestadls_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://lcingestadls.dfs.core.windows.net/"
        },
        "AzureDatabricks2_properties_typeProperties_existingClusterId": {
            "type": "string",
            "defaultValue": "1125-233119-o9n3i84a"
        },
        "AzureDatabricks3_properties_typeProperties_existingClusterId": {
            "type": "string",
            "defaultValue": "1125-233119-o9n3i84a"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "[concat(parameters('factoryName'), '/lcingestadls')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "annotations": [],
                "type": "AzureBlobFS",
                "typeProperties": {
                    "url": "[parameters('lcingestadls_properties_typeProperties_url')]",
                    "accountKey": {
                        "type": "SecureString",
                        "value": "[parameters('lcingestadls_accountKey')]"
                    }
                }
            },
            "dependsOn": []
        },
        {
            "name": "[concat(parameters('factoryName'), '/AzureDatabricks1')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "annotations": [],
                "type": "AzureDatabricks",
                "typeProperties": {
                    "domain": "https://adb-4035575926301332.12.azuredatabricks.net",
                    "accessToken": {
                        "type": "SecureString",
                        "value": "[parameters('AzureDatabricks1_accessToken')]"
                    },
                    "newClusterNodeType": "Standard_D4ds_v5",
                    "newClusterNumOfWorker": "0",
                    "newClusterSparkEnvVars": {
                        "PYSPARK_PYTHON": "/databricks/python3/bin/python3"
                    },
                    "newClusterVersion": "16.4.x-scala2.12",
                    "clusterOption": "Fixed",
                    "newClusterInitScripts": []
                }
            },
            "dependsOn": []
        },
        {
            "name": "[concat(parameters('factoryName'), '/AzureDatabricks2')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "annotations": [],
                "type": "AzureDatabricks",
                "typeProperties": {
                    "domain": "https://adb-2231733496212994.14.azuredatabricks.net",
                    "accessToken": {
                        "type": "SecureString",
                        "value": "[parameters('AzureDatabricks2_accessToken')]"
                    },
                    "existingClusterId": "[parameters('AzureDatabricks2_properties_typeProperties_existingClusterId')]"
                }
            },
            "dependsOn": []
        },
        {
            "name": "[concat(parameters('factoryName'), '/AzureDatabricks3')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "annotations": [],
                "type": "AzureDatabricks",
                "typeProperties": {
                    "domain": "https://adb-2231733496212994.14.azuredatabricks.net",
                    "accessToken": {
                        "type": "SecureString",
                        "value": "[parameters('AzureDatabricks3_accessToken')]"
                    },
                    "existingClusterId": "[parameters('AzureDatabricks3_properties_typeProperties_existingClusterId')]"
                }
            },
            "dependsOn": []
        },
        {
            "name": "[concat(parameters('factoryName'), '/DS_Ingest_Sink')]",
            "type": "Microsoft.DataFactory/factories/datasets",
            "apiVersion": "2018-06-01",
            "properties": {
                "linkedServiceName": {
                    "referenceName": "lcingestadls",
                    "type": "LinkedServiceReference"
                },
                "parameters": {
                    "fileName": {
                        "type": "string"
                    }
                },
                "annotations": [],
                "type": "DelimitedText",
                "typeProperties": {
                    "location": {
                        "type": "AzureBlobFSLocation",
                        "fileName": {
                            "value": "@dataset().fileName",
                            "type": "Expression"
                        },
                        "fileSystem": "ingestion"
                    },
                    "columnDelimiter": ",",
                    "escapeChar": "\\",
                    "firstRowAsHeader": true,
                    "quoteChar": "\""
                },
                "schema": []
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/lcingestadls')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/DS_Ingest_Source')]",
            "type": "Microsoft.DataFactory/factories/datasets",
            "apiVersion": "2018-06-01",
            "properties": {
                "linkedServiceName": {
                    "referenceName": "lcingestadls",
                    "type": "LinkedServiceReference"
                },
                "parameters": {
                    "fileName": {
                        "type": "string"
                    }
                },
                "annotations": [],
                "type": "DelimitedText",
                "typeProperties": {
                    "location": {
                        "type": "AzureBlobFSLocation",
                        "fileName": {
                            "value": "@dataset().fileName",
                            "type": "Expression"
                        },
                        "fileSystem": "ingestion"
                    },
                    "columnDelimiter": ",",
                    "escapeChar": "\\",
                    "firstRowAsHeader": true,
                    "quoteChar": "\""
                },
                "schema": []
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/lcingestadls')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/Pipeline_Ingest_Loan')]",
            "type": "Microsoft.DataFactory/factories/pipelines",
            "apiVersion": "2018-06-01",
            "properties": {
                "activities": [
                    {
                        "name": "Copy_and_Rename",
                        "type": "Copy",
                        "dependsOn": [
                            {
                                "activity": "Generate timestamp",
                                "dependencyConditions": [
                                    "Completed"
                                ]
                            }
                        ],
                        "policy": {
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "source": {
                                "type": "BlobSource",
                                "recursive": true
                            },
                            "sink": {
                                "type": "BlobSink"
                            },
                            "enableStaging": false,
                            "translator": {
                                "type": "TabularTranslator",
                                "typeConversion": true,
                                "typeConversionSettings": {
                                    "allowDataTruncation": true,
                                    "treatBooleanAsNumber": false
                                }
                            }
                        },
                        "inputs": [
                            {
                                "referenceName": "DS_Ingest_Source",
                                "type": "DatasetReference",
                                "parameters": {
                                    "fileName": {
                                        "value": "@pipeline().parameters.fileName",
                                        "type": "Expression"
                                    }
                                }
                            }
                        ],
                        "outputs": [
                            {
                                "referenceName": "DS_Ingest_Sink",
                                "type": "DatasetReference",
                                "parameters": {
                                    "fileName": {
                                        "value": "@concat('loan_', variables('FileTimestamp'), '.csv')",
                                        "type": "Expression"
                                    }
                                }
                            }
                        ]
                    },
                    {
                        "name": "Delete_Original",
                        "type": "Delete",
                        "dependsOn": [
                            {
                                "activity": "Copy_and_Rename",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "policy": {
                            "timeout": "0.12:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "dataset": {
                                "referenceName": "DS_Ingest_Source",
                                "type": "DatasetReference",
                                "parameters": {
                                    "fileName": {
                                        "value": "@pipeline().parameters.fileName",
                                        "type": "Expression"
                                    }
                                }
                            },
                            "logStorageSettings": {
                                "linkedServiceName": {
                                    "referenceName": "lcingestadls",
                                    "type": "LinkedServiceReference"
                                }
                            },
                            "enableLogging": true,
                            "storeSettings": {
                                "type": "AzureBlobFSReadSettings",
                                "recursive": true,
                                "enablePartitionDiscovery": false
                            }
                        }
                    },
                    {
                        "name": "Run ETL",
                        "type": "DatabricksNotebook",
                        "dependsOn": [
                            {
                                "activity": "Renamed File Name",
                                "dependencyConditions": [
                                    "Completed"
                                ]
                            }
                        ],
                        "policy": {
                            "timeout": "0.12:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "notebookPath": "/Workspace/Users/pna42@sfu.ca/lending-club/notebooks/processing",
                            "baseParameters": {
                                "input_file": {
                                    "value": "@variables('RenamedFileName')",
                                    "type": "Expression"
                                }
                            }
                        },
                        "linkedServiceName": {
                            "referenceName": "AzureDatabricks2",
                            "type": "LinkedServiceReference"
                        }
                    },
                    {
                        "name": "Generate timestamp",
                        "type": "SetVariable",
                        "dependsOn": [],
                        "policy": {
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "variableName": "FileTimestamp",
                            "value": {
                                "value": "@formatDateTime(utcNow(),'yyyyMMddHHmmss')",
                                "type": "Expression"
                            }
                        }
                    },
                    {
                        "name": "Renamed File Name",
                        "type": "SetVariable",
                        "dependsOn": [
                            {
                                "activity": "Copy_and_Rename",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "policy": {
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "variableName": "RenamedFileName",
                            "value": {
                                "value": "@concat('loan_', variables('FileTimestamp'), '.csv')",
                                "type": "Expression"
                            }
                        }
                    },
                    {
                        "name": "Run Partitioning",
                        "type": "DatabricksNotebook",
                        "dependsOn": [
                            {
                                "activity": "Run ETL",
                                "dependencyConditions": [
                                    "Completed"
                                ]
                            }
                        ],
                        "policy": {
                            "timeout": "0.12:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "notebookPath": "/Workspace/Users/pna42@sfu.ca/lending-club/notebooks/partitioning"
                        },
                        "linkedServiceName": {
                            "referenceName": "AzureDatabricks2",
                            "type": "LinkedServiceReference"
                        }
                    },
                    {
                        "name": "Run Financial Analysis",
                        "type": "DatabricksNotebook",
                        "dependsOn": [
                            {
                                "activity": "Run Partitioning",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "policy": {
                            "timeout": "0.12:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "notebookPath": "/Workspace/Users/pna42@sfu.ca/lending-club/notebooks/financial_portfolio_analysis"
                        },
                        "linkedServiceName": {
                            "referenceName": "AzureDatabricks2",
                            "type": "LinkedServiceReference"
                        }
                    },
                    {
                        "name": "Run Loan Analysis",
                        "type": "DatabricksNotebook",
                        "dependsOn": [
                            {
                                "activity": "Run Partitioning",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "policy": {
                            "timeout": "0.12:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "notebookPath": "/Workspace/Users/pna42@sfu.ca/lending-club/notebooks/loan_performance_analysis"
                        },
                        "linkedServiceName": {
                            "referenceName": "AzureDatabricks2",
                            "type": "LinkedServiceReference"
                        }
                    },
                    {
                        "name": "Run Borrower Segmentation Analysis",
                        "type": "DatabricksNotebook",
                        "dependsOn": [
                            {
                                "activity": "Run Partitioning",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "policy": {
                            "timeout": "0.12:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "notebookPath": "/Workspace/Users/pna42@sfu.ca/lending-club/notebooks/Borrower_Segmentation_Analysis"
                        },
                        "linkedServiceName": {
                            "referenceName": "AzureDatabricks3",
                            "type": "LinkedServiceReference"
                        }
                    },
                    {
                        "name": "Run Model Training and Testing",
                        "type": "DatabricksNotebook",
                        "dependsOn": [
                            {
                                "activity": "Run Financial Analysis",
                                "dependencyConditions": [
                                    "Completed"
                                ]
                            },
                            {
                                "activity": "Run Loan Analysis",
                                "dependencyConditions": [
                                    "Completed"
                                ]
                            },
                            {
                                "activity": "Run Borrower Segmentation Analysis",
                                "dependencyConditions": [
                                    "Completed"
                                ]
                            }
                        ],
                        "policy": {
                            "timeout": "0.12:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "notebookPath": "/Workspace/Users/pna42@sfu.ca/lending-club/notebooks/model_train"
                        },
                        "linkedServiceName": {
                            "referenceName": "AzureDatabricks3",
                            "type": "LinkedServiceReference"
                        }
                    }
                ],
                "policy": {
                    "elapsedTimeMetric": {}
                },
                "parameters": {
                    "fileName": {
                        "type": "string",
                        "defaultValue": "loan.csv"
                    }
                },
                "variables": {
                    "RenamedFileName": {
                        "type": "String"
                    },
                    "FileTimestamp": {
                        "type": "String"
                    }
                },
                "annotations": [],
                "lastPublishTime": "2025-11-26T00:16:25Z"
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/datasets/DS_Ingest_Source')]",
                "[concat(variables('factoryId'), '/datasets/DS_Ingest_Sink')]",
                "[concat(variables('factoryId'), '/linkedServices/AzureDatabricks2')]",
                "[concat(variables('factoryId'), '/linkedServices/AzureDatabricks3')]",
                "[concat(variables('factoryId'), '/linkedServices/lcingestadls')]"
            ]
        }
    ]
}